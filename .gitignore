# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Local VS Code preferences are not application source.
.vscode/

# Local toolchains and module/build caches.
.tmp/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets and signing material: never commit these.
.env
.env.*
*.pem
*.key
*.p12
*.jks
*.keystore
key.properties
google-services.json
GoogleService-Info.plist

# Rive CLI build output (the .riv files are published into assets/chests/rive/).
design/rive/*/build/
